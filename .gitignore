# Python
__pycache__/
*.pyc
.venv/
venv/

# Raw fetch cache is an audit trail, not source-of-truth — don't commit the dumps.
data/raw/*
!data/raw/.gitkeep

# Processed datasets are GENERATED by the pipeline on each machine. They are NOT
# committed — committing them made every local run dirty the tree and block
# `git pull`. Regenerate them any time with:  python scripts/run_pipeline.py
data/processed/*
!data/processed/.gitkeep

# The curated SEEDS (data/seed/*) and all code/config ARE committed.
