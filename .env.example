# Halo environment configuration
#
# The MVP runs out of the box on an in-memory seed store (no configuration
# required) so the directory is browsable and every flow works locally.
# To back Halo with a real Supabase Postgres instance, set the values below
# and apply lib/db/schema.sql. See lib/data/store.ts for the adapter seam.

# --- Supabase (production data layer) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption / hashing for contributor & listing contacts ---
# 32-byte base64 key used to encrypt stored phone numbers at rest.
HALO_CONTACT_ENCRYPTION_KEY=
# Secret salt used for deterministic phone hashing (duplicate detection).
HALO_PHONE_HASH_SALT=

# --- Google Places (seed candidate discovery only; server-only) ---
GOOGLE_PLACES_API_KEY=
