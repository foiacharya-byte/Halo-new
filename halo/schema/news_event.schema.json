{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewsEvent",
  "type": "object",
  "required": ["id", "title", "date", "source_links", "last_updated"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "short_summary": {"type": "string"},
    "date": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "locations_involved": {"type": "array", "items": {"type": "string"}},
    "sentiment": {"type": "string", "enum": ["positive", "neutral", "negative"]},
    "status": {"type": "string", "enum": ["reported", "confirmed"]},
    "cluster_id": {"type": ["string", "null"]},
    "source_links": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "last_updated": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"},
    "takedown": {"type": "boolean"}
  }
}
