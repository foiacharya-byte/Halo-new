{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TripSpot",
  "type": "object",
  "required": ["id", "name", "source_links", "last_updated"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "distance_km": {"type": ["number", "null"]},
    "type": {"type": "string"},
    "best_for_mood": {"type": "array", "items": {"type": "string"}},
    "description_summary": {"type": "string"},
    "how_to_reach": {"type": "string"},
    "source_links": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "last_updated": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"},
    "takedown": {"type": "boolean"}
  }
}
