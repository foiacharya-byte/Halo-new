{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service",
  "type": "object",
  "required": ["id", "name", "category", "source_ids", "last_updated"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "category": {"type": "string"},
    "description_summary": {"type": "string"},
    "address": {"type": "string"},
    "locality": {"type": "string"},
    "phone_numbers": {"type": "array", "items": {"type": "string"},
      "description": "Normalised. NEVER auto-published; requires contact_consent=true (DPDP)."},
    "contact_consent": {"type": "boolean"},
    "rating_score": {"type": ["number", "null"]},
    "rating_count": {"type": ["integer", "null"]},
    "halo_rating": {"type": ["number", "null"]},
    "halo_five_star": {"type": "boolean"},
    "permanently_closed": {"type": "boolean"},
    "source_platforms": {"type": "array", "items": {"type": "string"}},
    "last_seen": {"type": "string"},
    "source_links": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "last_updated": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"},
    "takedown": {"type": "boolean"}
  }
}
